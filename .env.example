# ==============================================================================
# TITANFIT FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# ==============================================================================

# Backend API Base URL (Spring Boot server)
# Default local port is 8080
NEXT_PUBLIC_API_ENDPOINT=http://localhost:8080

# Fallback API URLs (Supported by config.ts / kzone-fe architecture)
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Frontend Public URL (Used for SEO, OpenGraph, Canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
